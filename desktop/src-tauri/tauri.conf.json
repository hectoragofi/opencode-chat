{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCode Chat",
  "version": "1.0.0",
  "identifier": "ai.opencodechat.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/opencode-chat-server"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
